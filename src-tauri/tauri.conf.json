{
    "build": {
        "beforeBuildCommand": "npm run build",
        "beforeDevCommand": "npm run dev",
        "frontendDist": "./dist",
        "devUrl": "http://localhost:5173",
        "removeUnusedCommands": true
    },
    "bundle": {
        "active": true,
        "category": "DeveloperTool",
        "copyright": "",
        "targets": [],
        "externalBin": [],

        "windows": {
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": ""
        },
        "longDescription": "",
        "macOS": {
            "entitlements": null,
            "exceptionDomain": "",
            "frameworks": [],
            "providerShortName": null,
            "signingIdentity": null
        },
        "resources": [],
        "shortDescription": "",
        "linux": {
            "deb": {
                "depends": []
            }
        }
    },
    "productName": "tess",
    "mainBinaryName": "tess",
    "version": "0.7.0",
    "identifier": "dev.tessapp",
    "plugins": {},
    "app": {
        "windows": [
            {
                "title": "Tess",
                "width": 1440,
                "height": 810,
                "minWidth": 640,
                "minHeight": 360,
                "fullscreen": false,
                "resizable": true,
                "transparent": true,
                "decorations": false,
                "useHttpsScheme": true
            }
        ],
        "security": {
            "assetProtocol": {
                "scope": {
                    "allow": ["**"],
                    "requireLiteralLeadingDot": false
                },
                "enable": true
            },
            "csp": null
        }
    }
}
